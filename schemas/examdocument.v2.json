{
  "$defs": {
    "Answer": {
      "description": "Correct answer, if answer key is in scope.",
      "properties": {
        "correct_options": {
          "items": {
            "type": "string"
          },
          "title": "Correct Options",
          "type": "array"
        },
        "numeric_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Range"
        },
        "numeric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Value"
        }
      },
      "title": "Answer",
      "type": "object"
    },
    "AnswerSpec": {
      "description": "Detailed answer specification and range.",
      "properties": {
        "correct_options": {
          "items": {
            "type": "string"
          },
          "title": "Correct Options",
          "type": "array"
        },
        "numeric_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Range"
        },
        "numeric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Value"
        },
        "text_solution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Solution"
        }
      },
      "title": "AnswerSpec",
      "type": "object"
    },
    "BBox": {
      "description": "Bounding box in pixel coordinates (origin top-left).",
      "properties": {
        "x1": {
          "title": "X1",
          "type": "integer"
        },
        "x2": {
          "title": "X2",
          "type": "integer"
        },
        "y1": {
          "title": "Y1",
          "type": "integer"
        },
        "y2": {
          "title": "Y2",
          "type": "integer"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BBox",
      "type": "object"
    },
    "BlankNode": {
      "properties": {
        "expected_type": {
          "default": "text",
          "title": "Expected Type",
          "type": "string"
        },
        "index": {
          "default": 1,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "const": "blank",
          "default": "blank",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "BlankNode",
      "type": "object"
    },
    "Block": {
      "description": "Atomic unit of recognized content on a page.\n\nEvery piece of text, formula, or detected region is a Block.",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "bbox_norm": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox Norm"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "crop_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Ref"
        },
        "drop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drop Reason"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "lang": {
          "$ref": "#/$defs/Lang",
          "default": "unknown"
        },
        "latex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latex"
        },
        "order": {
          "default": 0,
          "title": "Order",
          "type": "integer"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EngineSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/BlockStatus",
          "default": "trusted"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/BlockType",
          "default": "text"
        }
      },
      "required": [
        "id",
        "page",
        "bbox"
      ],
      "title": "Block",
      "type": "object"
    },
    "BlockStatus": {
      "description": "Trust level of a block's content.",
      "enum": [
        "trusted",
        "disputed",
        "repaired",
        "human",
        "dropped"
      ],
      "title": "BlockStatus",
      "type": "string"
    },
    "BlockType": {
      "description": "Classification of a recognized block on a page.",
      "enum": [
        "text",
        "formula",
        "figure",
        "table",
        "header",
        "footer",
        "page_number",
        "watermark",
        "logo",
        "qr_code",
        "url",
        "unknown"
      ],
      "title": "BlockType",
      "type": "string"
    },
    "Cell": {
      "description": "A single cell in a table.",
      "properties": {
        "colspan": {
          "default": 1,
          "title": "Colspan",
          "type": "integer"
        },
        "lang": {
          "anyOf": [
            {
              "$ref": "#/$defs/Lang"
            },
            {
              "type": "string"
            }
          ],
          "default": "unknown",
          "title": "Lang"
        },
        "rowspan": {
          "default": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "title": "Cell",
      "type": "object"
    },
    "CodeNode": {
      "properties": {
        "kind": {
          "const": "code",
          "default": "code",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "default": "",
          "title": "Language",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "title": "CodeNode",
      "type": "object"
    },
    "DocumentPart": {
      "description": "Semantic document section / partition.",
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Blocks",
          "type": "array"
        },
        "kind": {
          "enum": [
            "cover",
            "instructions",
            "section_header",
            "answer_key",
            "solutions",
            "rough_work",
            "omr"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pages": {
          "items": {
            "type": "integer"
          },
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DocumentPart",
      "type": "object"
    },
    "EngineSource": {
      "description": "A single engine's reading of a block.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "latex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latex"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "engine"
      ],
      "title": "EngineSource",
      "type": "object"
    },
    "ExamMetadata": {
      "description": "Metadata harvested from cover/header before deletion.",
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "exam_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exam Name"
        },
        "series_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series Code"
        },
        "source_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Type"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "total_questions_expected": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Questions Expected"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "title": "ExamMetadata",
      "type": "object"
    },
    "Figure": {
      "description": "A detected figure/diagram with its crop and classification.",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "classification": {
          "$ref": "#/$defs/FigureClass",
          "default": "unknown"
        },
        "crop_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Path"
        },
        "format": {
          "default": "png",
          "title": "Format",
          "type": "string"
        },
        "height_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Mm"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "option_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Option Ref"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "perceptual_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perceptual Hash"
        },
        "question_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Ref"
        },
        "scale_class": {
          "default": "img-md",
          "title": "Scale Class",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BlockStatus",
          "default": "trusted"
        },
        "watermark_residual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Watermark Residual"
        },
        "width_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width Mm"
        }
      },
      "required": [
        "id",
        "page",
        "bbox"
      ],
      "title": "Figure",
      "type": "object"
    },
    "FigureClass": {
      "enum": [
        "diagram",
        "formula",
        "table",
        "logo",
        "qr",
        "photo",
        "unknown"
      ],
      "title": "FigureClass",
      "type": "string"
    },
    "FigureNode": {
      "properties": {
        "caption": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Caption",
          "type": "object"
        },
        "figure_ref": {
          "default": "",
          "title": "Figure Ref",
          "type": "string"
        },
        "kind": {
          "const": "figure",
          "default": "figure",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "FigureNode",
      "type": "object"
    },
    "Issue": {
      "description": "A problem detected during processing.",
      "properties": {
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "candidates": {
          "items": {
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        },
        "element_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Id"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "question_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Id"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity",
          "default": "warning"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "stage"
      ],
      "title": "Issue",
      "type": "object"
    },
    "IssueSeverity": {
      "enum": [
        "blocker",
        "warning",
        "info"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "Lang": {
      "enum": [
        "en",
        "hi",
        "mixed",
        "unknown"
      ],
      "title": "Lang",
      "type": "string"
    },
    "LanguageInfo": {
      "description": "Declared language and script metadata.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "direction": {
          "default": "ltr",
          "enum": [
            "ltr",
            "rtl"
          ],
          "title": "Direction",
          "type": "string"
        },
        "script": {
          "default": "Latin",
          "title": "Script",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "LanguageInfo",
      "type": "object"
    },
    "Marks": {
      "description": "Grading / marking scheme for a question.",
      "properties": {
        "negative": {
          "default": 1.0,
          "title": "Negative",
          "type": "number"
        },
        "partial": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial"
        },
        "positive": {
          "default": 4.0,
          "title": "Positive",
          "type": "number"
        }
      },
      "title": "Marks",
      "type": "object"
    },
    "MatchColumnsNode": {
      "properties": {
        "kind": {
          "const": "match_columns",
          "default": "match_columns",
          "title": "Kind",
          "type": "string"
        },
        "left": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Left",
          "type": "array"
        },
        "right": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Right",
          "type": "array"
        }
      },
      "title": "MatchColumnsNode",
      "type": "object"
    },
    "MathNode": {
      "properties": {
        "code": {
          "default": "",
          "title": "Code",
          "type": "string"
        },
        "display": {
          "default": false,
          "title": "Display",
          "type": "boolean"
        },
        "kind": {
          "const": "math",
          "default": "math",
          "title": "Kind",
          "type": "string"
        },
        "notation": {
          "default": "latex",
          "enum": [
            "latex",
            "mhchem"
          ],
          "title": "Notation",
          "type": "string"
        },
        "texts": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Texts",
          "type": "object"
        }
      },
      "title": "MathNode",
      "type": "object"
    },
    "Option": {
      "description": "A single option (choice) within a question.",
      "properties": {
        "content": {
          "items": {
            "discriminator": {
              "mapping": {
                "blank": "#/$defs/BlankNode",
                "code": "#/$defs/CodeNode",
                "figure": "#/$defs/FigureNode",
                "match_columns": "#/$defs/MatchColumnsNode",
                "math": "#/$defs/MathNode",
                "raw_crop": "#/$defs/RawCropNode",
                "statements": "#/$defs/StatementsNode",
                "table": "#/$defs/TableNode",
                "text": "#/$defs/TextNode"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextNode"
              },
              {
                "$ref": "#/$defs/MathNode"
              },
              {
                "$ref": "#/$defs/TableNode"
              },
              {
                "$ref": "#/$defs/FigureNode"
              },
              {
                "$ref": "#/$defs/StatementsNode"
              },
              {
                "$ref": "#/$defs/MatchColumnsNode"
              },
              {
                "$ref": "#/$defs/CodeNode"
              },
              {
                "$ref": "#/$defs/BlankNode"
              },
              {
                "$ref": "#/$defs/RawCropNode"
              }
            ]
          },
          "title": "Content",
          "type": "array"
        },
        "figure_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Figure Ref"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "text_en": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Text En",
          "type": "array"
        },
        "text_hi": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Text Hi",
          "type": "array"
        },
        "text_str_en": {
          "default": "",
          "title": "Text Str En",
          "type": "string"
        },
        "text_str_hi": {
          "default": "",
          "title": "Text Str Hi",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "PageClassification": {
      "enum": [
        "cover",
        "instructions",
        "questions",
        "answer_key",
        "rough_work",
        "blank",
        "omr",
        "unknown"
      ],
      "title": "PageClassification",
      "type": "string"
    },
    "PageInfo": {
      "description": "Per-page metadata from S0 intake.",
      "properties": {
        "blur_score": {
          "default": 0.0,
          "title": "Blur Score",
          "type": "number"
        },
        "classification": {
          "$ref": "#/$defs/PageClassification",
          "default": "unknown"
        },
        "cleaned_image_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cleaned Image Path"
        },
        "column_count": {
          "default": 1,
          "title": "Column Count",
          "type": "integer"
        },
        "contrast": {
          "default": 0.0,
          "title": "Contrast",
          "type": "number"
        },
        "dpi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dpi"
        },
        "has_annotation_ink": {
          "default": false,
          "title": "Has Annotation Ink",
          "type": "boolean"
        },
