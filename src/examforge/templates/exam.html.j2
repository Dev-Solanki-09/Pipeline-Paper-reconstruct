<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="generator" content="ExamForge v0.1.0"/>
    <meta name="examforge:spec-hash" content="{{ spec_hash }}"/>
    {% if metadata.exam_name %}
    <meta name="examforge:exam" content="{{ metadata.exam_name }}"/>
    {% endif %}
    {% if metadata.year %}
    <meta name="examforge:year" content="{{ metadata.year }}"/>
    {% endif %}
    <title>{{ metadata.exam_name or "Question Paper" }}{% if metadata.year %} ({{ metadata.year }}){% endif %}{% if metadata.subject %} — {{ metadata.subject }}{% endif %}</title>

    <!-- MathJax 3 for high-fidelity TeX-SVG rendering -->
    <script>
        window.MathJax = {
            tex: {
                inlineMath: [['\\(', '\\)'], ['$', '$']],
                displayMath: [['\\[', '\\]'], ['$$', '$$']]
            },
            svg: {
                fontCache: 'global'
            }
        };
    </script>
    <script async id="MathJax-script" src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js" type="text/javascript"></script>

    <style>
        /* === Authentic Real NEET Dual-Column Bilingual Continuous Layout === */
        * {
            box-sizing: border-box;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        *::-webkit-scrollbar {
            display: none;
        }
        body {
            margin: auto;
            padding: 18px 24px;
            background: #ffffff;
            font-family: 'Noto Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            font-size: 21px;
            color: #111;
            max-width: 1400px;
            line-height: 1.5;
        }
        [lang="hi"] {
            font-family: 'Noto Sans Devanagari', 'Noto Sans', sans-serif;
            line-height: 1.6;
        }

        /* 50/50 Dual-Column Bilingual Continuous Question Flow — Zero artificial borders */
        .questions-container {
            width: 100%;
        }
        .question-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 34px;
            gap: 4%;
            width: 100%;
            page-break-inside: avoid;
            break-inside: avoid;
            border: none;
            padding: 0;
        }
        .col, .col-50 {
            width: 48%;
            max-width: 48%;
            flex: 0 0 48%;
            min-width: 0;
            line-height: 1.55;
            padding: 0;
            border: none;
        }
        .col-en {
            /* Left column: English */
            border: none;
        }
        .col-hi {
            /* Right column: Hindi */
            border: none;
        }
        .q-layout {
            display: flex;
            gap: 12px;
            width: 100%;
            min-width: 0;
            align-items: flex-start;
        }
        .q-serial {
            flex: 0 0 38px;
            font-weight: bold;
            font-size: 1.05em;
            line-height: 1.45;
            color: #111;
            text-align: right;
            padding-right: 4px;
        }
        .q-content {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }
        .q-text {
            font-weight: bold;
            margin-bottom: 8px;
            line-height: 1.45;
            min-width: 0;
        }

        /* Tightly Coupled Options: Always One Option Per Line (1, 2, 3, 4) */
        .options-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-top: 6px;
            width: 100%;
        }
        .options-list > div {
            min-width: 0;
            width: 100%;
            word-wrap: break-word;
            line-height: 1.5;
        }

        /* Canonical Diagram Embedding & Scale Taxonomy */
        .diagram-frame,
        .q-image-container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            margin: 10px 0;
        }
        .q-diagram,
        .q-image-container img {
            display: block;
            height: auto;
            max-width: 100%;
            object-fit: contain;
            image-rendering: -webkit-optimize-contrast;
            background: transparent;
        }
        .img-inline { max-height: 38px; display: inline-block; vertical-align: middle; }
        .img-opt    { max-height: 55px; max-width: 220px; display: inline-block; vertical-align: middle; }
        .img-sm     { max-height: 110px; max-width: 240px; }
        .img-md     { max-height: 180px; max-width: 280px; }
        .img-wide   { max-height: 165px; max-width: 340px; }
        .img-grid   { max-height: 260px; max-width: 350px; }
        .img-lg     { max-height: 290px; max-width: 340px; }
        .img-match  { max-height: 440px; max-width: 370px; }
        .img-xl     { max-height: 480px; max-width: 380px; }

        mjx-container {
            max-width: 100%;
            overflow: visible !important;
        }
        mjx-container svg {
            max-width: 100%;
            height: auto;
        }
        .q-text mjx-container {
            font-size: 1.1em !important;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 5px;
            margin-bottom: 5px;
        }
        td {
            padding: 4px;
            vertical-align: top;
        }

        /* Section divider (if any section in document) */
        .section-divider {
            text-align: center;
            font-weight: 700;
            font-size: 1.05em;
            padding: 6px 0;
            margin: 16px 0 20px 0;
            text-transform: uppercase;
            border-top: 1px solid #333;
            border-bottom: 1px solid #333;
        }

        /* Page summary (only shown in fallback when no questions extracted yet) */
        .page-summary {
            margin: 1.5em 0;
            padding: 1em;
            background: #f8f8f8;
            border: 1px solid #ddd;
        }
        .page-summary h2 {
            font-size: 1.1em;
            margin-bottom: 0.5em;
        }
        .page-summary table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9em;
        }
        .page-summary th, .page-summary td {
            padding: 0.3em 0.5em;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        /* Unconstrained Native Browser Printing System (Ctrl+P) */
        @media print {
            body {
                padding: 0;
                background: transparent;
                max-width: 100%;
                font-size: 17px;
            }
            .question-row {
                page-break-inside: avoid;
                break-inside: avoid;
                margin-bottom: 22px;
                border: none;
                padding: 0;
            }
            .diagram-frame, .q-image-container {
                page-break-inside: avoid;
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>

    {% if questions %}
    <div class="questions-container">
        {% for question in questions %}
        {% if question.section and (loop.first or question.section != loop.previtem.section) %}
        <div class="section-divider">{{ question.section }}</div>
        {% endif %}

        <div class="question-row" id="q{{ question.number }}">
            <!-- Left Column: English (50%) -->
            <div class="col col-50 col-en" lang="en">
                <div class="q-layout">
                    <div class="q-serial">{{ question.number }}.</div>
                    <div class="q-content">
                        <div class="q-text">
                            {% if question.stem_text_en %}{{ question.stem_text_en | safe }}{% else %}{% for block in question.stem_en %}{{ block.text | safe }}{% endfor %}{% endif %}
                        </div>

                        {% for fig_id in question.figure_refs %}
                        {% set fig = figures | selectattr("id", "equalto", fig_id) | first %}
                        {% if fig and fig.crop_path and not fig.option_ref %}
                        <div class="diagram-frame">
                            <img src="{{ fig.crop_path | b64_image }}" alt="Figure for Q{{ question.number }}" class="q-diagram {{ fig.scale_class or 'img-md' }}">
                        </div>
                        {% endif %}
                        {% endfor %}

                        {% if question.options %}
                        <div class="options-list">
                            {% for option in question.options %}
                            <div>
                                {% if option.label.startswith('(') %}{{ option.label }}{% else %}({{ option.label }}){% endif %} {% if option.text_str_en %}{{ option.text_str_en | safe }}{% else %}{% for block in option.text_en %}{{ block.text | safe }}{% endfor %}{% endif %}
                                {% for fig_id in question.figure_refs %}
                                {% set opt_fig = figures | selectattr("id", "equalto", fig_id) | first %}
                                {% if opt_fig and opt_fig.crop_path and (opt_fig.option_ref == option.label or opt_fig.option_ref == '(' ~ option.label ~ ')') %}
                                <div class="diagram-frame" style="margin: 4px 0;">
                                    <img src="{{ opt_fig.crop_path | b64_image }}" alt="Option {{ option.label }}" class="q-diagram {{ opt_fig.scale_class or 'img-opt' }}">
                                </div>
                                {% endif %}
                                {% endfor %}
                            </div>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Right Column: Hindi (50%) -->
            <div class="col col-50 col-hi" lang="hi">
                <div class="q-layout">
                    <div class="q-serial">{{ question.number }}.</div>
                    <div class="q-content">
                        <div class="q-text">
                            {% if question.stem_text_hi %}{{ question.stem_text_hi | safe }}{% elif question.stem_hi %}{% for block in question.stem_hi %}{{ block.text | safe }}{% endfor %}{% else %}{% if question.stem_text_en %}{{ question.stem_text_en | safe }}{% else %}{% for block in question.stem_en %}{{ block.text | safe }}{% endfor %}{% endif %}{% endif %}
                        </div>

                        {% for fig_id in question.figure_refs %}
                        {% set fig = figures | selectattr("id", "equalto", fig_id) | first %}
                        {% if fig and fig.crop_path and not fig.option_ref %}
                        <div class="diagram-frame">
                            <img src="{{ fig.crop_path | b64_image }}" alt="Figure for Q{{ question.number }}" class="q-diagram {{ fig.scale_class or 'img-md' }}">
                        </div>
                        {% endif %}
                        {% endfor %}

                        {% if question.options %}
                        <div class="options-list">
                            {% for option in question.options %}
                            <div>
                                {% if option.label.startswith('(') %}{{ option.label }}{% else %}({{ option.label }}){% endif %} {% if option.text_str_hi %}{{ option.text_str_hi | safe }}{% elif option.text_hi %}{% for block in option.text_hi %}{{ block.text | safe }}{% endfor %}{% else %}{% if option.text_str_en %}{{ option.text_str_en | safe }}{% else %}{% for block in option.text_en %}{{ block.text | safe }}{% endfor %}{% endif %}{% endif %}
                                {% for fig_id in question.figure_refs %}
                                {% set opt_fig = figures | selectattr("id", "equalto", fig_id) | first %}
                                {% if opt_fig and opt_fig.crop_path and (opt_fig.option_ref == option.label or opt_fig.option_ref == '(' ~ option.label ~ ')') %}
                                <div class="diagram-frame" style="margin: 4px 0;">
                                    <img src="{{ opt_fig.crop_path | b64_image }}" alt="Option {{ option.label }}" class="q-diagram {{ opt_fig.scale_class or 'img-opt' }}">
                                </div>
                                {% endif %}
                                {% endfor %}
                            </div>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    {% if not questions %}
    <!-- Document summary when no questions extracted yet -->
    <div class="page-summary">
        <h2>ExamForge — Document Summary</h2>
        <p>
            <strong>Source:</strong> {{ document.source_path | e }}<br>
            <strong>Pages:</strong> {{ pages | length }}<br>
            <strong>Questions:</strong> {{ questions | length }}<br>
            <strong>Issues:</strong> {{ issues | length }}
        </p>

        <table>
            <thead>
                <tr>
                    <th>Page</th>
                    <th>Type</th>
                    <th>Text Layer</th>
                    <th>DPI</th>
                    <th>Blur</th>
                    <th>Columns</th>
                </tr>
            </thead>
            <tbody>
                {% for page in pages %}
                <tr>
                    <td>{{ page.page_number }}</td>
                    <td>{{ page.classification.value }}</td>
                    <td>
                        {% if page.text_layer_valid %}✓ valid
                        {% elif page.has_text_layer %}⚠ invalid
                        {% else %}✗ none
                        {% endif %}
                    </td>
                    <td>{% if page.dpi %}{{ page.dpi | round(0) }}{% else %}—{% endif %}</td>
                    <td>{% if page.blur_score is not none %}{{ page.blur_score | round(1) }}{% else %}—{% endif %}</td>
                    <td>{{ page.column_count }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="page-summary">
        <h2>Page Previews</h2>
        <p><em>Questions will appear here once extracted. Showing rendered intake page images below.</em></p>
    </div>
    {% for page in question_pages %}
    {% if page.image_path %}
    <div class="q-image-container" style="margin: 1em 0;">
        <p style="font-size: 0.8em; color: #888;">Page {{ page.page_number }}</p>
        <img src="{{ page.image_path | b64_image }}"
             alt="Page {{ page.page_number }}"
             style="max-width: 100%; border: 1px solid #ddd;">
    </div>
    {% endif %}
    {% endfor %}
    {% endif %}

</body>
</html>
